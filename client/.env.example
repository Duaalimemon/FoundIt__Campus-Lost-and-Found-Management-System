# Frontend Environment Configuration (Example)
# In development, points to local Express API
# Note: Changing VITE_* variables requires rebuilding the frontend bundle
VITE_API_BASE_URL=http://localhost:5000/api

# Google OAuth 2.0 Web Client ID (for Student Google Sign-In)
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id_here.apps.googleusercontent.com

